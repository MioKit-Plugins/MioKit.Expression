<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Expression</RootNamespace>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <!-- MioKit 插件程序集位于 nupkg 根目录，不作为 lib 资产发布。 -->
        <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
        <PackageId>$(MSBuildProjectName)</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MioKit.Extensions" Version="1.3.0"/>
        <PackageReference Include="MioKit.Webview2" Version="1.3.0"/>
        <PackageReference Include="MioKit.SourceGenerate" Version="1.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1"/>
        <PackageReference Include="NCalcAsync" Version="7.0.0"/>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- Keep MioKit host assemblies out of the plugin directory while copying NCalc's runtime closure. -->
        <NCalcDebugRuntimePackageIds>NCalcAsync;NCalc.Core;NCalc.Domain;NCalc.Parser;NExtendedNumerics.BigDecimal;Parlot;Microsoft.Extensions.Configuration;Microsoft.Extensions.Configuration.Abstractions;Microsoft.Extensions.Configuration.Binder;Microsoft.Extensions.DependencyInjection;Microsoft.Extensions.DependencyInjection.Abstractions;Microsoft.Extensions.Logging;Microsoft.Extensions.Logging.Abstractions;Microsoft.Extensions.Logging.Configuration;Microsoft.Extensions.Logging.Console;Microsoft.Extensions.Logging.TraceSource;Microsoft.Extensions.Options;Microsoft.Extensions.Options.ConfigurationExtensions;Microsoft.Extensions.Primitives</NCalcDebugRuntimePackageIds>
    </PropertyGroup>

    <Target Name="CopyNCalcDebugRuntimeDependencies"
            AfterTargets="Build"
            DependsOnTargets="ResolvePackageAssets"
            Condition="'$(Configuration)' == 'Debug'">
        <ItemGroup>
            <NCalcDebugRuntimeDll Include="@(RuntimeCopyLocalItems)"
                                  Condition="$([System.String]::Copy(';$(NCalcDebugRuntimePackageIds);').Contains(';%(RuntimeCopyLocalItems.NuGetPackageId);'))"/>
        </ItemGroup>
        <Copy SourceFiles="@(NCalcDebugRuntimeDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"/>
    </Target>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath=""/>
        <None Update="plugin.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Update="Assets\icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>Assets/icon.png</PackagePath>
        </None>
        <None Remove="Assets\systemFunc.js"/>
        <EmbeddedResource Include="Assets\systemFunc.js"/>
        <Content Include="ui\dist\**\*" Condition="Exists('ui\dist')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>ui/dist</PackagePath>
        </Content>
    </ItemGroup>

    <Target Name="GenerateMioKitPluginManifest" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('plugin.json')" Text="MioKit 插件包必须在项目根目录提供 plugin.json。"/>
        <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;&amp; { $json = Get-Content -Raw -Encoding UTF8 'plugin.json' | ConvertFrom-Json; if ($json.metadataVersion -ne '1.0' -or [string]::IsNullOrWhiteSpace($json.id) -or [string]::IsNullOrWhiteSpace($json.name) -or [string]::IsNullOrWhiteSpace($json.assembly) -or [string]::IsNullOrWhiteSpace($json.minSdkVersion)) { throw 'plugin.json 必须使用 metadataVersion 1.0，并包含非空的 id、name、assembly 和 minSdkVersion。' }; foreach ($field in @('pluginVersion','releaseState','releaseDate')) { if ($json.PSObject.Properties.Name -contains $field) { throw ('plugin.json 禁止发布字段: ' + $field) } } }&quot;"/>
        <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;&amp; { $plugin = Get-Content -Raw -Encoding UTF8 'plugin.json' | ConvertFrom-Json; $envelope = [ordered]@{ schema = 'miokit.plugin-package'; schemaVersion = 1; plugin = $plugin }; $directory = '$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)'; New-Item -ItemType Directory -Force $directory | Out-Null; $envelope | ConvertTo-Json -Depth 100 -Compress | Set-Content -NoNewline -Encoding utf8 (Join-Path $directory 'miokit-package-description.json') }&quot;"/>
        <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;&amp; { $plugin = Get-Content -Raw -Encoding UTF8 'plugin.json' | ConvertFrom-Json; $icon = [string]$plugin.icon; $path = '$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)miokit-package-icon.txt'; if ([string]::IsNullOrWhiteSpace($icon)) { if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force } } else { $icon.Replace('\','/') | Set-Content -NoNewline -Encoding utf8 $path } }&quot;"/>
        <ReadLinesFromFile File="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)miokit-package-icon.txt" Condition="Exists('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)miokit-package-icon.txt')">
            <Output TaskParameter="Lines" ItemName="_MioKitPackageIconLines"/>
        </ReadLinesFromFile>
        <PropertyGroup>
            <PackageDescription>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)miokit-package-description.json'))</PackageDescription>
            <PackageIcon>@(_MioKitPackageIconLines)</PackageIcon>
        </PropertyGroup>
    </Target>
</Project>
